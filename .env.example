# ─── SCOF Environment Configuration Template ───────────────────
SCOF_PROFILE_PATH=./profiles/mvp-electronics
SCOF_ENV=development

# ─── PostgreSQL ─────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=scof
POSTGRES_USER=scof
POSTGRES_PASSWORD=changeme

# ─── Neo4j ──────────────────────────────────────────────────
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# ─── Redis ──────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ─── Kafka ──────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ─── Ports ──────────────────────────────────────────────────
COORDINATOR_PORT=8010
DEMAND_AGENT_PORT=8011
INVENTORY_AGENT_PORT=8012
SUPPLIER_AGENT_PORT=8013
TRANSPORT_AGENT_PORT=8014
API_PORT=8000
FRONTEND_PORT=3000

# ─── Observability ──────────────────────────────────────────
LANGSMITH_API_KEY=
LANGFUSE_HOST=http://langfuse:4000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
